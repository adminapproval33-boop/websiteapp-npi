# Salin file ini menjadi ".env" lalu sesuaikan nilainya.

# Koneksi PostgreSQL. Kalau pakai docker-compose bawaan project ini,
# nilai default di bawah sudah cocok dengan service "postgres".
DATABASE_URL="postgresql://npi_user:npi_password@localhost:5432/npi_db?schema=public"

PORT=4000

# Asal (origin) frontend yang diizinkan mengakses API ini (CORS).
CORS_ORIGIN="http://localhost:5173"

# Lama sesi login tetap aktif selama masih dipakai (menit). Nilai besar (10
# tahun) supaya tidak ada auto-logout karena idle -- logout harus manual.
SESSION_TTL_MINUTES=5256000

# Batas percobaan login salah sebelum NIK dikunci sementara.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=5

# Vercel Blob (object storage) untuk file upload (lampiran).
# Buat Blob store (Private) di dashboard Vercel -> Storage, lalu copy token read-write-nya.
BLOB_READ_WRITE_TOKEN=""
MAX_UPLOAD_MB=20

# Batas ukuran KHUSUS file Import Master Data (Order/Tanki) -- dibuat jauh
# lebih besar krn file referensi seperti export SAP-COOISPI bisa jutaan baris.
MAX_IMPORT_MB=500

# Dipakai HANYA oleh "npm run seed" untuk membuat 1 akun Full Access
# pertama kali (bootstrap). Setelah itu, kelola user lewat menu User
# Management, bukan lewat env ini.
SEED_ADMIN_NIK="000001"
SEED_ADMIN_NAME="Administrator"
SEED_ADMIN_DEPARTMENT="IT"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Mode maintenance: kalau "true", HANYA NIK di MAINTENANCE_ALLOWED_NIK yang
# bisa login/pakai sesi -- semua user lain ditolak & sesi aktifnya diputus paksa.
MAINTENANCE_MODE=false
MAINTENANCE_ALLOWED_NIK=""
