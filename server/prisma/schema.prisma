generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccessLevel {
  INPUT
  VIEW
  FULL_ACCESS
}

enum ProductionSection {
  PREMIX
  AFTERMIX
}

/// Pengguna aplikasi. Menggantikan Sheet "USER". Tidak ada lagi akun
/// developer khusus di luar tabel ini (beda dari versi Apps Script) --
/// admin awal dibuat lewat seed script dan login lewat jalur yang sama
/// seperti user lain.
model User {
  nik               String   @id
  name              String
  department        String
  passwordHash      String
  access            AccessLevel @default(INPUT)
  /// Level akses per-menu (lihat lib/menuAccess.ts, MENU_KEYS) -- generalisasi
  /// dari `restrictedMenus` lama, 3 level per menu (2026-08-03, instruksi
  /// eksplisit user): default (tidak ada di kedua array ini) = INPUT (akses
  /// penuh), ada di `viewOnlyMenus` = VIEW (cuma bisa lihat History/Queue,
  /// tidak bisa Save), ada di `hiddenMenus` = HIDE (menu hilang dari sidebar,
  /// GET/POST-nya ditolak total). TIDAK berlaku utk FULL_ACCESS (lihat
  /// requireMenuView/requireMenuInput di middleware/auth.ts) -- murni utk
  /// user INPUT/VIEW biasa.
  hiddenMenus       String[] @default([])
  viewOnlyMenus     String[] @default([])
  mustResetPassword Boolean  @default(false)
  /// Pathname foto avatar di Vercel Blob (private), diisi lewat menu Settings > Profil.
  avatarPath        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  sessions          Session[]

  @@map("users")
}

/// Sesi login, menggantikan CacheService token di versi lama.
/// Sliding expiration ditegakkan di middleware (bukan di DB).
model Session {
  token     String   @id @default(uuid())
  nik       String
  user      User     @relation(fields: [nik], references: [nik], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([nik])
  @@map("sessions")
}

/// Referensi Order/PO (dulu dibaca dari Spreadsheet eksternal SAP-COOISPI).
/// Diisi lewat halaman Import CSV/Excel (Full Access).
model MasterOrder {
  id                      Int      @id @default(autoincrement())
  order                   String   @unique
  batch                   String?
  materialNumber          String?
  materialDescription     String?
  orderQty                String?
  plant                   String?
  /// Kolom tambahan dari hasil compile COOISPI (VLOOKUP%) -- semua opsional
  /// karena file lama/sumber lain mungkin tidak menyediakannya.
  deliveredQtyLiter       String?
  basicStartDate          String?
  basicFinishDate         String?
  systemStatus            String?
  unitOfMeasure           String?
  pctGR                   String?
  actStartDate            String?
  actEndDate              String?
  volume                  String?
  deliveredQtyPcs         String?
  orderQtyPcs             String?
  abcIndicatorDescription String?
  todayAtp                String?
  t7Atp                   String?
  jenis                   String?
  warnaDasar              String?
  documentHeaderText      String?
  abcIndicator            String?
  orderType               String?
  updatedAt               DateTime @updatedAt

  @@index([materialNumber])
  @@map("master_orders")
}

/// Daftar Code Tanki (dulu dibaca dari Spreadsheet eksternal).
/// Diisi lewat halaman Import CSV/Excel (Full Access), format: TA/TB,
/// Tank Capacity, New Number, Code Tanki, Location / Plant, Type Tanki.
model MasterTank {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  taTb          String?
  tankCapacity  String?
  newNumber     String?
  locationPlant String?
  typeTanki     String?
  updatedAt     DateTime @updatedAt

  @@map("master_tanks")
}

/// Master Data > Daftar Code Mesin (2026-08-02, instruksi eksplisit user,
/// sumber pertama file "list mesin.xlsx" -- Code Mesin Milling + Lokasi).
/// Dipakai Dashboard > Mesin Monitoring utk daftar mesin resmi (join by
/// `code` ke `codeMesin` di MillingLog), sama polanya dgn MasterTank utk
/// Tank Monitoring.
model MasterMesin {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  lokasi    String?
  updatedAt DateTime @updatedAt

  @@map("master_mesin")
}

/// Master rute proses per Material Number (menu Master Data > Material Flow
/// Proses, sumbernya file "ALL FLOW PROSES.xlsx" -- 2026-07-31, instruksi
/// eksplisit user). Menjawab "tahap mana saja yg WAJIB dilalui Material ini"
/// -- TIDAK semua Material lewat ketujuh tahap (Premix/Milling/Aftermix
/// bahkan sering di-skip sama sekali, cuma QC & Packing yg selalu wajib di
/// SEMUA Material). Dipakai sbg sumber kebenaran resmi utk penguncian urutan
/// tahap di lib/stageGate.ts, menggantikan heuristik "pernah ada histori log
/// di tahap itu" yg dipakai sementara sebelum file ini ada.
model MaterialFlow {
  id                     Int      @id @default(autoincrement())
  materialNumber         String   @unique
  materialDescription    String?
  premixRequired         Boolean  @default(false)
  millingRequired        Boolean  @default(false)
  aftermixRequired       Boolean  @default(false)
  colourMatchingRequired Boolean  @default(false)
  qcRequired             Boolean  @default(false)
  approvalRequired       Boolean  @default(false)
  packingRequired        Boolean  @default(false)
  updatedAt              DateTime @updatedAt

  @@map("material_flows")
}

/// Tab "Input Manual" di Dashboard > Tank Monitoring (2026-07-31, instruksi
/// eksplisit user). Status okupansi Tank di tab "Monitoring Tanki" dihitung
/// OTOMATIS dari histori Premix/Milling/Aftermix/Colour Matching -- kadang
/// selisih dari kondisi fisik sebenarnya (mis. Order sudah "Done"/"Teco"
/// menurut sistem, tapi tanki-nya aktualnya masih terisi). Model ini murni
/// catatan manual TERPISAH dari perhitungan otomatis itu -- tidak
/// memengaruhi/menimpa status Tank Monitoring otomatis sama sekali, cuma
/// daftar sendiri di tab "Input Manual" supaya kondisi aktual itu tetap
/// tercatat & terlihat.
model TankManualInput {
  id                  String   @id @default(uuid())
  timestamp           DateTime @default(now())
  codeTanki           String
  order               String
  materialNumber      String?
  materialDescription String?
  batch               String?
  orderQty            String?
  remark              String?
  inputBy             String

  @@index([codeTanki])
  @@map("tank_manual_inputs")
}

/// Dashboard > Production Order Monitoring > tombol "+Input Manual" (2026-08-03,
/// instruksi eksplisit user) -- catatan manual TERPISAH dari perhitungan otomatis
/// tabel Production Order Monitoring, dipakai kalau ada Order yang datanya belum/
/// tidak lengkap secara otomatis. Sama konsepnya dgn TankManualInput, tapi tampil
/// di modal tersendiri (bukan digabung ke tabel utama, karena tabel utama dihitung
/// dari rangkaian tahap proses yang kompleks & tidak relevan utk catatan manual ini).
model ProductionOrderManualInput {
  id                  String    @id @default(uuid())
  timestamp           DateTime  @default(now())
  order               String
  materialNumber      String?
  materialDescription String?
  orderQty            String?
  plant               String?
  iuPlant             String?
  codeTanki           String?
  start               DateTime?
  finish              DateTime?
  spvProduksi         String
  leader              String?
  /// array nama anggota, mis. ["Budi","Sari"]
  members             Json?
  inputBy             String

  @@index([order])
  @@map("production_order_manual_inputs")
}

/// Data karyawan (menu Master Data > Employee Data). Diisi lewat import
/// CSV/Excel (Full Access), format export HR: Employee ID, Full Name,
/// Organization, Job Position, Departemen.
model MasterEmployee {
  id           Int      @id @default(autoincrement())
  employeeId   String   @unique
  fullName     String
  organization String?
  jobPosition  String?
  departemen   String?
  plant        String?
  updatedAt    DateTime @updatedAt

  @@map("master_employees")
}

/// Planning Schedule > Milling.
model MillingLog {
  id                  Int      @id @default(autoincrement())
  timestamp           DateTime @default(now())
  order               String
  materialNumber      String?
  materialDescription String?
  batch               String
  orderQty            String?
  plant               String?
  iuPlant             String
  codeTanki1          String?
  codeTanki2          String?
  codeMesin           String?
  formReceived        DateTime?
  start               DateTime?
  finish              DateTime?
  spvProduksi         String
  leader              String?
  /// Qty Aktual hasil Milling -- diisi manual, beda dari Order Qty (rencana)
  qtyAct              String?
  /// array nama anggota, mis. ["Budi","Sari"]
  members             Json?
  /// 10 slot bacaan tetap, disimpan sbg array (boleh string kosong utk slot yg belum diisi)
  fineness            Json?
  visco               Json?
  suhu                Json?
  remark              String?
  inputBy             String
  attachments         MillingAttachment[]

  @@index([order])
  @@map("milling_logs")
}

model MillingAttachment {
  id         Int         @id @default(autoincrement())
  order      String
  fileName   String
  filePath   String
  fileType   String?
  uploadedBy String
  timestamp  DateTime    @default(now())
  logId      Int?
  log        MillingLog? @relation(fields: [logId], references: [id], onDelete: SetNull)

  @@index([order])
  @@map("milling_attachments")
}

/// Planning Schedule > Premix & Aftermix (1 tabel, dibedakan kolom `section`).
model PremixAftermixLog {
  id                  Int               @id @default(autoincrement())
  section             ProductionSection
  timestamp           DateTime          @default(now())
  order               String
  materialNumber      String?
  materialDescription String?
  batch               String
  orderQty            String?
  plant               String?
  iuPlant             String?
  spvProduksi         String
  /// array nama anggota, mis. ["Budi","Sari"]
  members             Json?
  /// Order Qty dibagi jumlah member (otomatis)
  qtyPerMan           String?
  start               DateTime?
  leader              String?
  finish              DateTime?
  codeTanki           String
  formReceived        DateTime?
  remark              String?
  inputBy             String
  attachments         PremixAftermixAttachment[]

  @@index([order])
  @@index([section])
  @@map("premix_aftermix_logs")
}

model PremixAftermixAttachment {
  id         Int                @id @default(autoincrement())
  section    ProductionSection
  order      String
  fileName   String
  filePath   String
  fileType   String?
  uploadedBy String
  timestamp  DateTime           @default(now())
  logId      Int?
  log        PremixAftermixLog? @relation(fields: [logId], references: [id], onDelete: SetNull)

  @@index([order])
  @@map("premix_aftermix_attachments")
}

/// Jadwal PWO (2026-08-04, instruksi eksplisit user) -- tampilan kalender
/// mingguan di tab "PWO Schedule & Queue" (Premix/Aftermix). Order yg sama
/// boleh dijadwalkan ulang (upsert by order+section lewat @@unique di
/// bawah). Field identitas (materialNumber/materialDescription/batch)
/// di-snapshot saat dijadwalkan supaya kartu kalender bisa langsung
/// ditampilkan tanpa perlu join ulang ke sumber antrian (yg dinamis --
/// Premix dari Master Data, Aftermix dari History Milling). Murni metadata
/// jadwal, TIDAK terhubung ke PremixAftermixLog.
model PwoSchedule {
  id                  String            @id @default(uuid())
  order               String
  section             ProductionSection
  materialNumber      String?
  materialDescription String?
  batch               String?
  scheduledStart      DateTime
  scheduledEnd        DateTime
  createdBy           String
  timestamp           DateTime          @default(now())

  @@unique([order, section])
  @@map("pwo_schedules")
}

/// Planning Schedule > Colour Matching.
model ColourMatchingLog {
  id                  Int      @id @default(autoincrement())
  timestamp           DateTime @default(now())
  order               String
  materialNumber      String?
  materialDescription String?
  batch               String
  orderQty            String?
  plant               String?
  iuPlant             String?
  codeTanki           String
  typesOfProducts     String?
  baseColor           String?
  /// 1 No Order (form ini) dibagi jumlah member (otomatis) -- bukan dari Order Qty
  formPerMan          String?
  formReceived        DateTime?
  start               DateTime?
  finish              DateTime?
  spvName             String
  /// SPV Colour Matching (2026-08-03, instruksi eksplisit user) -- nullable
  /// di DB supaya baris histori lama (sebelum kolom ini ada) tidak pecah,
  /// tapi WAJIB diisi utk save baru/edit lewat validasi Zod di route.
  spvColourMatching   String?
  leaderName          String?
  /// array nama anggota, mis. ["Budi","Sari"] (gaya Premix/Aftermix)
  members             Json?
  remark              String?
  inputBy             String
  attachments         ColourMatchingAttachment[]

  @@index([order])
  @@map("colour_matching_logs")
}

model ColourMatchingAttachment {
  id         Int                @id @default(autoincrement())
  order      String
  fileName   String
  filePath   String
  fileType   String?
  uploadedBy String
  timestamp  DateTime           @default(now())
  logId      Int?
  log        ColourMatchingLog? @relation(fields: [logId], references: [id], onDelete: SetNull)

  @@index([order])
  @@map("colour_matching_attachments")
}

/// Production & MRP Schedule > Bongkaran (2026-08-03, instruksi eksplisit
/// user) -- tahap ke-5 dlm urutan proses (setelah Colour Matching), TAPI
/// SENGAJA TIDAK terhubung ke Master Data > Material Flow Proses/stageGate.ts
/// sama sekali (bukan tahap wajib/opsional per Material, tidak ada gerbang
/// prasyarat) -- logikanya sama spt pop-up "Input Manual": bebas diisi kapan
/// saja, tidak mengubah/dicek dari Master Data. Field jauh lebih ringkas dari
/// tahap lain (tanpa IU Plant/Code Tanki/Start/Finish) sesuai layout form yg
/// diminta user -- "Send To PQE" (datetime) adalah SATU-SATUNYA milestone:
/// begitu terisi, kolom "Proses" di Production Order Monitoring berubah jadi
/// "Produksi - PQE" (lihat bongkaranProcessLabel di dashboard.routes.ts).
model BongkaranLog {
  id                  Int      @id @default(autoincrement())
  timestamp           DateTime @default(now())
  order               String
  materialNumber      String?
  materialDescription String?
  batch               String?
  orderQty            String?
  plant               String?
  spvName             String
  leaderName          String?
  /// array nama anggota, mis. ["Budi","Sari"] (gaya Premix/Aftermix/Colour Matching)
  members             Json?
  /// Milestone AWAL (2026-08-03, instruksi eksplisit user) -- ditambahkan
  /// belakangan, menyusul field "Send To PQE" yg sudah ada duluan. TIDAK
  /// mengubah kriteria "Selesai" Bongkaran (tetap murni dari sendToPqe, lihat
  /// MaterialFlowPanel.tsx/bongkaranProcessLabel di dashboard.routes.ts) --
  /// cuma milestone tambahan spy konsisten dgn pola Form Received di semua
  /// tahap lain (Premix/Milling/Aftermix/Colour Matching).
  formReceived        DateTime?
  sendToPqe           DateTime?
  remark              String?
  inputBy             String
  attachments         BongkaranAttachment[]

  @@index([order])
  @@map("bongkaran_logs")
}

model BongkaranAttachment {
  id         Int           @id @default(autoincrement())
  order      String
  fileName   String
  filePath   String
  fileType   String?
  uploadedBy String
  timestamp  DateTime      @default(now())
  logId      Int?
  log        BongkaranLog? @relation(fields: [logId], references: [id], onDelete: SetNull)

  @@index([order])
  @@map("bongkaran_attachments")
}

/// Planning Schedule > Packing.
model PackingLog {
  id                  Int      @id @default(autoincrement())
  timestamp           DateTime @default(now())
  spvNik              String?
  spvName             String
  leaderNik           String?
  leaderName          String?
  nik                 String?
  employeeName        String?
  /// array nama anggota, mis. ["Budi","Sari"]
  members             Json?
  order               String
  materialNumber      String?
  materialDescription String?
  batch               String
  orderQty            String?
  plant               String?
  iuPlant             String?
  /// Order Qty dibagi jumlah member (otomatis)
  qtyPerMan           String?
  /// Ditampilkan sbg "Volume" di form -- auto-saran dari kolom "Volume" di
  /// Referensi Order/PO (SAP-COOISPI), fallback ke Order Qty kalau kosong
  /// (dulu selalu mirror Order Qty, direvisi 2026-07-26)
  totalQty            String?
  /// Qty dalam satuan Pcs -- diisi manual, terpisah dari Volume (Ltr)
  qtyPcs              String?
  codeTanki           String
  formReceived        DateTime?
  start               DateTime?
  finish              DateTime?
  remark              String?
  inputBy             String
  attachments         PackingAttachment[]

  @@index([order])
  @@map("packing_logs")
}

model PackingAttachment {
  id         Int         @id @default(autoincrement())
  order      String
  fileName   String
  filePath   String
  fileType   String?
  uploadedBy String
  timestamp  DateTime    @default(now())
  logId      Int?
  log        PackingLog? @relation(fields: [logId], references: [id], onDelete: SetNull)

  @@index([order])
  @@map("packing_attachments")
}

/// Quality Control > Creating Product Spek. specId = group key (dulu "Spec ID").
model ProductSpec {
  specId              String                  @id @default(uuid())
  timestamp           DateTime                @default(now())
  materialNumber      String
  materialDescription String
  information         String?
  inputBy             String
  parameters          ProductSpecParameter[]

  @@index([materialNumber])
  @@map("product_specs")
}

model ProductSpecParameter {
  id           Int         @id @default(autoincrement())
  specId       String
  spec         ProductSpec @relation(fields: [specId], references: [specId], onDelete: Cascade)
  no           Int
  itemCheck    String
  standardSpec String?
  unit         String?
  remark       String?

  @@index([specId])
  @@map("product_spec_parameters")
}

/// Quality Control > Input Check Results. checkId = group key (dulu "Check ID").
model CheckResult {
  checkId             String                  @id @default(uuid())
  timestamp           DateTime                @default(now())
  order               String
  materialNumber      String?
  materialDescription String?
  batch               String?
  customer            String?
  custSegmen          String?
  orderQty            String?
  plant               String?
  iuPlant             String?
  lotCoa              String?
  codeTanki           String?
  remark              String?
  appearanceNotes     String?
  information         String?
  checkNotes          String?
  start               DateTime?
  finish              DateTime?
  inputBy             String
  parameters          CheckResultParameter[]
  appearanceFiles     IcrAppearanceFile[]

  @@index([order])
  @@map("check_results")
}

model CheckResultParameter {
  id        Int         @id @default(autoincrement())
  checkId   String
  check     CheckResult @relation(fields: [checkId], references: [checkId], onDelete: Cascade)
  no        Int
  parameter String
  standard  String?
  result    String?
  remark    String?
  start     DateTime?
  finish    DateTime?
  pic       String?

  @@index([checkId])
  @@map("check_result_parameters")
}

model IcrAppearanceFile {
  id         Int         @id @default(autoincrement())
  checkId    String
  check      CheckResult @relation(fields: [checkId], references: [checkId], onDelete: Cascade)
  order      String?
  batch      String?
  fileName   String
  filePath   String
  fileType   String?
  uploadedBy String
  timestamp  DateTime    @default(now())

  @@index([checkId])
  @@map("icr_appearance_files")
}

/// Planning Schedule > Approval. approvalId = group key (dulu "Approval ID").
/// Admin QC Stage/Lot Passed/QC to App/QC Passed DIPINDAH ke model AdminQc
/// terpisah (2026-07-28, lihat komentar di sana) -- kalau perlu nilai QC to
/// App/QC Passed di sini, lookup AdminQc by `order`. Mrp Pic/Sales Pic sempat
/// ikut pindah ke AdminQc tapi DIKEMBALIKAN ke sini (2026-07-29, revisi
/// layout eksplisit user) karena keduanya bagian dari header Order/Plant,
/// bukan tahap QC.
model ApprovalSchedule {
  approvalId             String   @id @default(uuid())
  timestamp              DateTime @default(now())
  inputBy                String
  order                  String
  materialNumber         String?
  materialDescription    String?
  batch                  String?
  orderQty               String?
  plant                  String?
  iuPlant                String?
  codeTanki              String?
  mrpPic                 String?
  salesPic               String?
  prepareProduksi        DateTime?
  sprayMan               String?
  wetSample              String?
  panel                  String?
  lotCoa                 DateTime?
  sendToTech             DateTime?
  technicalDateReceiving DateTime?
  submitToCustomer       DateTime?
  customer               String?
  custSegmen             String?
  techName               String?
  finishApp              DateTime?
  remark                 String?
  attachments            ApprovalAttachment[]

  @@index([order])
  @@index([finishApp])
  @@map("approval_schedules")
}

model ApprovalAttachment {
  id         Int              @id @default(autoincrement())
  approvalId String
  approval   ApprovalSchedule @relation(fields: [approvalId], references: [approvalId], onDelete: Cascade)
  fileName   String
  filePath   String
  fileType   String?
  remark     String?
  uploadedBy String
  timestamp  DateTime         @default(now())

  @@index([approvalId])
  @@map("approval_attachments")
}

/// Portal Quality Control > Input Admin QC (2026-07-28). Header administratif
/// tahap QC (Admin QC Stage/Lot Passed/QC to App/QC Passed) -- SENGAJA
/// DIPISAH dari ApprovalSchedule (Production & MRP Schedule > Approval) jadi
/// tabel independen sendiri, terhubung ke Approval & ke modul lain HANYA
/// lewat nomor Order (bukan foreign key), sesuai instruksi eksplisit user:
/// pilihan "2 tabel terpisah" (bukan 1 record yg sama spt Premix/Aftermix).
/// Mrp Pic/Sales Pic sempat ikut ke sini tapi DIKEMBALIKAN ke ApprovalSchedule
/// (2026-07-29, revisi layout eksplisit user). Spec Parameters (Item Check)
/// di halaman ini TIDAK disimpan di sini -- itu tetap CheckResult/
/// CheckResultParameter yg SAMA dgn menu "Input Check Results" (1 sumber
/// data QC, dieditnya bisa dari 2 halaman).
model AdminQc {
  adminQcId           String    @id @default(uuid())
  timestamp           DateTime  @default(now())
  inputBy             String
  order               String
  materialNumber      String?
  materialDescription String?
  batch               String?
  orderQty            String?
  plant               String?
  iuPlant             String?
  codeTanki           String?
  typeLot             String?
  lotPassed           DateTime?
  qcToApproval        DateTime?
  qcPassed            DateTime?
  remark              String?
  attachments         AdminQcAttachment[]

  @@index([order])
  @@map("admin_qc")
}

model AdminQcAttachment {
  id         Int      @id @default(autoincrement())
  adminQcId  String
  adminQc    AdminQc  @relation(fields: [adminQcId], references: [adminQcId], onDelete: Cascade)
  fileName   String
  filePath   String
  fileType   String?
  remark     String?
  uploadedBy String
  timestamp  DateTime @default(now())

  @@index([adminQcId])
  @@map("admin_qc_attachments")
}

/// Production Label (2026-08-04, instruksi eksplisit user) -- histori tiap
/// kali label produksi dicetak dari menu Production Label Entry. Order/
/// Material Number/Description/Batch/Order Qty/Plant diambil dari Master
/// Data Order (OrderLookup, sama spt modul lain). codeTanki/iuPlant/remark
/// di-autofill dari input TERAKHIR across Premix/Aftermix/Milling/Approval/
/// Admin QC (lihat getLatestCrossModule di productionLabel.routes.ts) tapi
/// tetap bisa dioverride manual oleh operator sebelum cetak. lotNo/exp/
/// pasteType/drumColour TIDAK punya sumber otomatis di modul manapun --
/// selalu diisi manual oleh operator di form Cetak Label.
model ProductionLabel {
  id                  String    @id @default(uuid())
  timestamp           DateTime  @default(now())
  order               String
  materialNumber      String?
  materialDescription String?
  batch               String?
  orderQty            String?
  plant               String?
  lotNo               String?
  exp                 DateTime?
  /// Shelf Life -- isian manual (2026-08-04, instruksi eksplisit user), tidak ada sumber otomatisnya.
  shelfLife           String?
  codeTanki           String?
  iuPlant             String?
  /// "Paste" | "Kepala Warna" | "Assorted" -- dropdown manual, lihat komentar di ProductionLabelEntryPage.tsx.
  pasteType           String?
  drumColour          String?
  remark              String?
  printedBy           String

  @@index([order])
  @@map("production_labels")
}
